# Local development
FLASK_APP=app.py
FLASK_DEBUG=0
DATABASE_URL=sqlite:///bazaario.db
# PostgreSQL Docker Compose settings; replace the placeholder before use.
POSTGRES_DB=bazaario
POSTGRES_USER=bazaario
POSTGRES_PASSWORD=replace-with-a-long-random-password
# After choosing the same password above, set:
# DATABASE_URL=postgresql+psycopg://bazaario:<your-password>@127.0.0.1:5432/bazaario
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=86400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
